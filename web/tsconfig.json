{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../src/types/**/*.ts", "../src/data/**/*.ts", "../src/services/csvParser.ts", "../src/services/captureValidation.ts", "../src/services/reconciliationEngine.ts", "../src/services/reconciliationService.ts"]
}